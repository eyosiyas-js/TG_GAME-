generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  username      String?   @unique
  phoneNumber   String    @unique
  passwordHash  String
  avatar        String?
  level         Int       @default(1)
  exp           Int       @default(0)
  isBot         Boolean   @default(false)
  bonusMatches  Int       @default(0)
  botConfig     Json?     // { minDelay, maxDelay, winRate, maxConcurrentGames, preferredStakes }
  isBanned      Boolean   @default(false)
  wallet          Wallet?
  matches         MatchParticipant[]
  moves           MatchMove[]
  transactions    Transaction[]
  notifications   Notification[]
  depositRequests    DepositRequest[]
  withdrawalRequests WithdrawalRequest[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Wallet {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])
  balance Decimal @default(1000.00) @db.Decimal(12, 2)
  bonusBalance Decimal @default(0.00) @db.Decimal(12, 2)
}

model Match {
  id           String             @id @default(uuid())
  gameType     GameType
  matchType    MatchType          @default(QUICK)
  status       MatchStatus        @default(LOBBY)
  stake        Decimal            @db.Decimal(12, 2)
  winnerId     String?
  participants MatchParticipant[]
  moves        MatchMove[]
  transactions Transaction[]
  botGameState BotGameState?
  createdAt    DateTime           @default(now())
  endedAt      DateTime?
}

model MatchMove {
  id        String   @id @default(uuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  move      String
  createdAt DateTime @default(now())
}

model MatchParticipant {
  id      String @id @default(uuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])
}

model Transaction {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  amount        Decimal         @db.Decimal(12, 2)
  type          TransactionType
  matchId       String?
  match         Match?          @relation(fields: [matchId], references: [id])
  status        String          @default("PENDING")
  referenceCode String?
  approvedBy    String?
  approvedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime        @default(now())
}

enum GameType {
  BINGO
  RPS
  DICE
  GUESS
}

enum MatchType {
  QUICK
  ROOM
}

enum MatchStatus {
  LOBBY
  PRE_GAME
  PLAYING
  FINISHED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  STAKE
  WIN
  COMMISSION
  TRANSFER
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model DepositRequest {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  method        String
  senderName    String
  transactionId String?
  receiptUrl    String
  status        DepositStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model WithdrawalRequest {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  method      String
  phoneNumber String
  status      DepositStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("system")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  apiKey    String
  action    String
  target    String
  details   Json?
  ipAddress String
  createdAt DateTime @default(now())

  @@index([apiKey])
  @@index([createdAt])
}
model BotGameState {
  id              String   @id @default(uuid())
  matchId         String   @unique
  userId          String
  winningNumbers  Int[]
  calledNumbers   Int[]
  moveCount       Int      @default(0)
  strategy        String   @default("OPTIMAL")
  nextMoveAt      DateTime?
  isWinning       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id])
}
